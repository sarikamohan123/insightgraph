# InsightGraph Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values

# LLM Configuration (Required)
GEMINI_API_KEY=your_gemini_api_key_here
USE_LLM_EXTRACTOR=true
MAX_RETRIES=3
TIMEOUT_SECONDS=30

# Security Configuration (Phase 3)
# Set this to a secure random string to enable authentication
# Leave empty for development (all endpoints public)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# JWT Authentication (Phase 6)
# IMPORTANT: Change this in production!
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Database Configuration (Phase 3)
# Local: postgresql://dev:devpass@localhost:5432/insightgraph
# Neon:  postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/insightgraph?sslmode=require
DATABASE_URL=postgresql://dev:devpass@localhost:5432/insightgraph

# Redis Configuration (Phase 2)
# Local: redis://localhost:6379
# Upstash: rediss://default:xxx@xxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Production Configuration
# Set FRONTEND_URL to your Vercel deployment URL for CORS
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
